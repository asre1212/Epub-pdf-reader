{
  "name": "epub-pdf-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first PWA for reading EPUB and PDF books with highlighting and a compiled notes tab.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist public/pdfjs"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.8"
  }
}
